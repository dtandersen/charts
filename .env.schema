# API provider credentials for Pi (models.json) and OpenCode (opencode.jsonc).
# Safe to commit: secret keys are resolved at load time via the pass and
# Infisical plugins below — only entry paths are stored here, never values.
# Expected pass layout: <ENV_VAR_NAME> (e.g. NVIDIA_API_KEY)
# @plugin(@varlock/pass-plugin@1.0.1)
# @initPass()
# @plugin(@varlock/infisical-plugin@2.1.3)
# @initInfisical(projectId=a844d80b-28c4-49a8-9ce4-8354d4cbd2b5, environment=dev, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, siteUrl=$INFISICAL_SITE_URL)
# @defaultSensitive=false
# @defaultRequired=true
# ---

# @type=infisicalClientId
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal
INFISICAL_CLIENT_SECRET=
# @type=string
INFISICAL_SITE_URL=

# @sensitive=true
# @required=false
# @type=string(optional=true)
OPENROUTER_API_KEY=infisical()

# @sensitive=true
# @required=false
# @type=string(optional=true)
VLLM_API_KEY=infisical()

# @sensitive=true
# @required=false
# @type=string(optional=true)
XESTRATA_API_KEY=infisical()

